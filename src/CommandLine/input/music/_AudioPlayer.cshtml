@using SWGen.FileSystems
@inherits TemplatePage<AudioInfo>

@{
    var fileName = WorkFiles.Mp3FileName(Model.MovementKey);
    var audioUrl = WorkFiles.Url(Model.Fs, Model.ProjectRoot, Model.WorkDir, fileName);
}

@if (audioUrl is not null)
{
<div class="player">
    <audio>
        <source src="@audioUrl" type="audio/mpeg">
    </audio>
</div>
}
